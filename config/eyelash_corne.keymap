#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 5    // 10

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#include <behaviors.dtsi>
#include <input/processors.dtsi>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 1 3>; };

&msc {
  acceleration-exponent = <0>;         // 0
  time-to-max-speed-ms = <200>;  // 300
  delay-ms = <25>;                      // 0
};

&mmv {
  time-to-max-speed-ms = <500>;
  acceleration-exponent = <1>;
  trigger-period-ms = <16>;
};

/ {
  behaviors {
    td0: td0 {
      compatible = "zmk,behavior-tap-dance";
      display-name = "Shift/Caps Lock Tap Dance";
      #binding-cells = <0>;
      bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
    };
  };

  rgb_encoder: rgb_encoder {
    compatible = "zmk,behavior-sensor-rotate";
    #sensor-binding-cells = <0>;
    bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
  };

  td_l2: td_l2 {
    compatible = "zmk,behavior-tap-dance";
    #binding-cells = <0>;
    bindings = <&mo 2>, <&tog 2>;
  };

  td_fn: td_fn {
      compatible = "zmk,behavior-tap-dance";
      #binding-cells = <0>;
      bindings = <&kp RALT>, <&tog 4>;
      tapping-term-ms = <200>;
  };

  keymap {
    compatible = "zmk,keymap";

    0_default_layer {
      display-name = "QWERTY";
      bindings =
          <
            &kp TAB    &kp Q  &kp W     &kp E     &kp R  &kp T                                    &mmv MOVE_UP                &kp Y        &kp U  &kp I      &kp O    &kp P     &kp BSPC
            &td0       &kp A  &kp S     &kp D     &kp F  &kp G                     &mmv MOVE_LEFT &mkp LCLK  &mmv MOVE_RIGHT  &kp H        &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
            &kp LCTRL  &kp Z  &kp X     &kp C     &kp V  &kp B        &kp C_PLAY_PAUSE            &mmv MOVE_DOWN              &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                                        &kp LGUI  &mo 1  &kp SPACE                                                            &lt 3 ENTER  &td_l2 &td_fn
          >;

      sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
    };

    1_nav_layer {
      display-name = "NAV";
      bindings =
        <
          &kp N1  &kp N2 &kp N3 &kp N4  &kp N5  &kp N6                                    &mmv MOVE_UP                     &kp HOME     &kp END    &none        &none       &none            &trans
          &trans  &none  &none  &none   &none   &none                     &mmv MOVE_LEFT  &mkp RCLK       &mmv MOVE_RIGHT  &kp LEFT     &kp DOWN   &kp UP       &kp RIGHT   &kp PRINTSCREEN  &none
          &trans  &none  &none  &none   &none   &none            &trans                   &mmv MOVE_DOWN                   &kp PG_UP    &kp PG_DN  &none        &none       &kp SCROLLLOCK   &trans
                                &trans  &trans  &trans                                                                     &trans       &kp DEL    &trans
        >;

      sensor-bindings = <&inc_dec_kp DOWN UP>;
    };

    2_number_symbol_layer{
      display-name = "NUMSYM";
      bindings = 
        <
          &none  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                                      &mmv MOVE_UP                     &none    &kp N7  &kp N8   &kp N9  &none   &none
          &none  &kp F6   &kp F7   &kp F8  &kp F9  &kp F10                     &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none    &kp N4  &kp N5   &kp N6  &none   &none
          &none  &kp F11  &kp F12  &none   &none   &none       &kp C_MUTE                      &mmv MOVE_DOWN                   &none    &kp N1  &kp N2   &kp N3  &kp DOT &kp COMMA
                                   &trans  &trans  &trans                                                                       &kp INS  &td_l2  &trans
        >;

      sensor-bindings = <&inc_dec_kp DOWN UP>;
    };

    3_f_keys_layer{
      display-name = "F1-12";
      bindings =
        <
          &studio_unlock  &kp F1      &kp F2     &kp F3       &kp F4     &kp F5                                    &mmv MOVE_UP                     &none  &none   &none  &none  &none &none
          &trans          &kp F6      &kp F7     &kp F8       &kp F9     &kp F10                   &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none  &none   &none  &none  &none &none
          &trans          &kp F11     &kp F12    &none        &none      &none       &kp C_MUTE                    &mmv MOVE_DOWN                   &none  &none   &none  &none  &none &none
                                                 &trans       &trans     &trans                                                                     &trans &trans  &td_fn
        >;

      sensor-bindings = <&inc_dec_kp DOWN UP>;
    };

    4_fn_layer{
      display-name = "FN";
      bindings = 
        <
          &trans    &bt BT_CLR       &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2     &bt BT_SEL 3                                  &mmv MOVE_UP                     &rgb_ug RGB_OFF  &rgb_ug RGB_ON   &none            &none        &none     &none 
          &trans    &rgb_ug RGB_EFF  &rgb_ug RGB_EFR &rgb_ug RGB_SPI &rgb_ug RGB_BRI  &rgb_ug RGB_BRD               &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &out OUT_USB     &out OUT_BLE     &none            &none        &none     &none
          &trans    &trans           &trans          &trans          &sys_reset       &bootloader     &kp C_MUTE                    &mmv MOVE_DOWN                   &bootloader      &sys_reset       &none            &none        &none     &none
                                                     &trans          &trans           &trans                                                                         &trans           &trans           &td_fn
        >;

      sensor-bindings = <&inc_dec_kp DOWN UP>;
    };
  };
};
